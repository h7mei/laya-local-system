LAYA_HOST=127.0.0.1
LAYA_PORT=8000
LAYA_DEVICE=cpu
# Lazy-load into RAM at first predict; files must already be in HF_HOME
# (serve.py downloads missing models on start). Set to 1 to load into RAM at startup.
LAYA_PRELOAD=0
LAYA_MODELS=english,multilingual
HF_HOME=.cache/huggingface
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DISABLE_XET=1
# Hugging Face token (higher rate limits). Keep real value in .env only.
HF_TOKEN=
# Optional: require Authorization: Bearer <key> on POST /v1/systemone
# LAYA_API_KEY=
# Optional ngrok: public URL for remote API clients (see /api page)
# NGROK_AUTHTOKEN=
# LAYA_NGROK=1
# Optional: after models are cached, uncomment to block Hub fetches at runtime
# HF_HUB_OFFLINE=1
