LAYA_HOST=127.0.0.1
LAYA_PORT=8000
# auto = use CUDA when available, else CPU. Or set cuda / cpu explicitly.
LAYA_DEVICE=auto
# Preload checkpoints into GPU/RAM at startup (recommended on GPU machines).
LAYA_PRELOAD=1
LAYA_MODELS=english,multilingual
HF_HOME=.cache/huggingface
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DISABLE_XET=1
# Hugging Face token (higher rate limits). Keep real value in .env only.
HF_TOKEN=
# Optional: require Authorization: Bearer <key> on POST /v1/systemone
# (prefer generating/saving the key on http://127.0.0.1:8000/api — stored in SQLite)
# LAYA_API_KEY=
# Optional ngrok: public URL for remote API clients (see /api page)
# (prefer pasting the token on the /api Keys panel — stored in SQLite)
# NGROK_AUTHTOKEN=
# LAYA_NGROK=1
# Optional: after models are cached, uncomment to block Hub fetches at runtime
# HF_HUB_OFFLINE=1
# Optional: SQLite path for usage monitor (default: data/usage.sqlite)
# LAYA_USAGE_DB=data/usage.sqlite
